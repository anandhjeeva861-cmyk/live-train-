{
  "name": "live-train-tracking-first-fullstack",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch server.js",
    "start": "node server.js",
    "build:pages": "node scripts/build-pages.js",
    "check": "node scripts/check.js",
    "test": "node --test tests/assistant.test.js tests/tracking.test.js",
