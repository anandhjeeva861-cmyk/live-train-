PORT=4173
DATABASE_URL=file:./prisma/dev.db
JWT_SECRET=
SESSION_SECRET=
FRONTEND_URL=http://localhost:4173
# Exact origins only; GitHub Pages repository paths do not belong here.
ALLOWED_ORIGINS=https://live-train-five.vercel.app,https://anandhjeeva861-cmyk.github.io,http://localhost:4174,http://127.0.0.1:4174
# Blank uses lax on local HTTP and none with secure production HTTPS cookies.
SESSION_SAME_SITE=
TRUST_PROXY=false
RESEND_API_KEY=
EMAIL_FROM=
# Choose resend or smtp. Gmail setup: npm run auth:setup
EMAIL_PROVIDER=resend
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Public backend origin for hosted frontend builds (no secrets).
RAILGO_BACKEND_URL=
# Set true on Vercel/Pages when email login must be connected at build time.
RAILGO_REQUIRE_EMAIL_LOGIN=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
