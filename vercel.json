{
  "$schema": "./.vscode/vercel.schema.json",
  "framework": null,
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "dist/vercel",
  "rewrites": [
    {
      "source": "/profile",
      "destination": "/index.html"
    },
    {
      "source": "/login",
      "destination": "/index.html"
    },
    {
      "source": "/dashboard",
      "destination": "/index.html"
    },
    {
      "source": "/book",
      "destination": "/index.html"
    },
    {
      "source": "/bookings",
      "destination": "/index.html"
    },
    {
      "source": "/tracking",
      "destination": "/index.html"
    }
  ],
  "installCommand": "npm ci --ignore-scripts",
  "trailingSlash": false
}
